name: Build cClydestales GUI

on:
  workflow_dispatch:
  push:
    branches:
      - main
      - master

permissions:
  contents: read

jobs:
  build:
    name: Build Geode Mod
    runs-on: ubuntu-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      - name: Build mod with Geode SDK
        uses: geode-sdk/build-geode-mod@main
        with:
          sdk: "v5.11.2"

      - name: Find built Geode package
        id: package
        shell: bash
        run: |
          FILE="$(find . -type f -name '*.geode' -print -quit)"
          if [ -z "$FILE" ]; then
            echo "No .geode package was produced."
            exit 1
          fi
          echo "file=$FILE" >> "$GITHUB_OUTPUT"

      - name: Upload installable mod
        uses: actions/upload-artifact@v4
        with:
          name: cClydestales-GUI
          path: ${{ steps.package.outputs.file }}
          if-no-files-found: error
          retention-days: 14
